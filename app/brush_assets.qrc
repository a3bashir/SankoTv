<RCC>
    <!-- Versioned brush assets: images a built-in recipe cannot express as
         code (HANDOFF "code plus versioned assets", 2026-08-29). This qrc
         must compile into EVERY target that builds BuiltinRoster.cpp
         (SankoTV, SankoBrushLibraryTest, SankoPresetDiff; the lifecycle
         family inherits the app's source list) - a target without it
         builds a roster whose image-bearing brushes load null tips and
         renders DIFFERENT presets than the app. (b11) trips if that
         happens to HB Pencil. -->
    <qresource prefix="/brushes">
        <file alias="hb_pencil_tip.png">assets/brushes/hb_pencil_tip.png</file>
        <file alias="pencil_4h_tip.png">assets/brushes/pencil_4h_tip.png</file>
        <file alias="pencil_2b_tip.png">assets/brushes/pencil_2b_tip.png</file>
        <file alias="pencil_6b_tip.png">assets/brushes/pencil_6b_tip.png</file>
        <file alias="pencil_h_tip.png">assets/brushes/pencil_h_tip.png</file>
        <file alias="pencil_2h_tip.png">assets/brushes/pencil_2h_tip.png</file>
        <file alias="pencil_4b_tip.png">assets/brushes/pencil_4b_tip.png</file>
        <file alias="pencil_mech_tip.png">assets/brushes/pencil_mech_tip.png</file>
        <file alias="pencil_blue_tip.png">assets/brushes/pencil_blue_tip.png</file>
        <file alias="pencil_charcoal_tip.png">assets/brushes/pencil_charcoal_tip.png</file>
    </qresource>
</RCC>
